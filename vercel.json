{
  
  "version": 2,
  
  "buildCommand": "pnpm build",
  
  "outputDirectory": "dist",
  
  "env": {
    
    "NODE_ENV": "production"
    
  },
  
  "routes": [
    
    {
      
      "src": "/api/(.*)",
      
      "dest": "api/index.ts",
      
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
      
    },
    
    {
      
      "src": "/(assets/.*)",
      
      "dest": "client/dist/$1"
      
    },
    
    {
      
      "src": "/(.*)",
      
      "dest": "client/dist/index.html"
      
    }
    
  ],
  
  "headers": [
    
    {
      
      "source": "/api/(.*)",
      
      "headers": [
        
        {
          
          "key": "Cache-Control",
          
          "value": "no-cache, no-store, must-revalidate"
          
        }
        
      ]
      
    }
    
  ]
  
}
































